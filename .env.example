# ============================================================
# Deep Research 产品 — 环境变量示例
# 复制为 .env 并填入实际值
# ============================================================

# ----- 外部基础设施（外部已有部署） -----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deep_research
REDIS_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530

# Langfuse（外部已部署；本仓库不打包）
LANGFUSE_HOST=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx

# ----- LLM 提供商 -----
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
# 节点级模型覆盖（D5 / Phase 7）。格式: MODEL_<NODE>=<provider>:<model>
MODEL_MAIN_PLAN=anthropic:claude-sonnet-5
MODEL_RESEARCH_DISPATCH=anthropic:claude-haiku-4-5
MODEL_RESEARCH_COVERAGE_CHECK=anthropic:claude-sonnet-5
MODEL_SQ_EXTRACT=anthropic:claude-sonnet-5
MODEL_SQ_REFLECT=anthropic:claude-sonnet-5
MODEL_WRITE_OUTLINE=anthropic:claude-haiku-4-5
MODEL_WRITE_SECTIONS=anthropic:claude-sonnet-5
MODEL_WRITE_REVISE=anthropic:claude-sonnet-5
MODEL_WRITE_SUMMARIZE=anthropic:claude-haiku-4-5
MODEL_JUDGE_CITATION=anthropic:claude-sonnet-5

# ----- 检索 -----
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-xxx

# 阿里云百炼 Web Search MCP（可选）
BAILIAN_MCP_URL=
BAILIAN_MCP_TOKEN=

# ----- 预算（D15 / D25） -----
SESSION_MAX_TOKENS_INPUT=100000
SESSION_MAX_TOKENS_OUTPUT=5000
SESSION_MAX_WALL_TIME_SECONDS=600
SESSION_MAX_COST_USD=2.0
RESEARCH_MAX_ITERATIONS=2
SQ_MAX_SUB_ITERATIONS=3

# ----- 覆盖率判定（D16） -----
MIN_FACTS_PER_SQ=3
MIN_CRITICAL_FACTS=5

# ----- 限流（D29） -----
RATE_LIMIT_USER_CONCURRENT=5
RATE_LIMIT_USER_HOUR=20
RATE_LIMIT_USER_DAY=100
RATE_LIMIT_TENANT_CONCURRENT=20
RATE_LIMIT_TENANT_HOUR=200
RATE_LIMIT_TENANT_DAY=1000
RATE_LIMIT_GLOBAL_CONCURRENT=50

# ----- JWT（D10） -----
JWT_SECRET=replace-me-with-32-byte-random-hex
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# ----- 应用 -----
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173